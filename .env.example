# ==============================================================================
# PULSE NEWS NETWORK — PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================

# Node Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=production
PORT=3000

# Base URL of application
APP_URL=https://pulse-news.org

# Database Configuration (Defaults to embedded SQLite in data/pulse_news.db if unset)
# For Enterprise PostgreSQL: postgresql://pulse_user:secret_password@localhost:5432/pulse_news
DATABASE_URL=file:./data/pulse_news.db

# Authentication & Cryptographic Salts
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_secure_random_64_character_hex_key
JWT_SECRET=change_this_to_another_secure_random_hex_key

# Password Hashing Parameters (Scrypt / Argon2id)
PASSWORD_SALT_ROUNDS=16384

# Email Service Provider (SMTP, Resend, SendGrid)
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=newsroom-notifications@pulse-news.org
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="Pulse Newsroom" <notifications@pulse-news.org>

# Rate Limiting & Abuse Prevention (Requests per window)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_LOCKOUT_DURATION_MS=60000

# File Upload Constraints
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/svg+xml

# Content Security Policy & CORS
ALLOWED_ORIGINS=https://pulse-news.org,http://localhost:5173,http://localhost:3000

# First-Administrator Bootstrap Protection (One-time setup only)
# Once bootstrapped, the /api/bootstrap endpoint permanently locks down.
BOOTSTRAP_SECRET=optional_secure_bootstrap_secret_token
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=


